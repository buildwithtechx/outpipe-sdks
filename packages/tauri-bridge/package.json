{
  "name": "@outpipe/tauri-bridge",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --noEmit false",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "description": "Tauri bridge for the Outpipe desktop client",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@outpipe/sdk": "0.1.1"
  },
  "peerDependencies": {
    "@tauri-apps/api": ">=2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
