{
  "name": "outpipe/outpipe-php",
  "description": "PHP and Laravel client for the Outpipe public tunnel API",
  "type": "library",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": "^8.2",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Outpipe\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Outpipe\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Outpipe\\Laravel\\OutpipeServiceProvider"
      ],
      "aliases": {
        "Outpipe": "Outpipe\\Laravel\\Facades\\Outpipe"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "check": "find src tests -type f -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
