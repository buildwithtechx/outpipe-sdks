{
  "name": "@outpipe/shared",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup index.ts crypto.ts --format esm --clean && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --noEmit false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": "./index.ts",
    "./crypto": "./crypto.ts",
    "./brand.css": "./theme.css",
    "./outpipe.svg": "./outpipe.svg"
  }
}
