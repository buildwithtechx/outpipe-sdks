{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outpipe.dev/protocol/messages.json",
  "title": "Outpipe Protocol",
  "protocolVersion": 1,
  "type": "object",
  "required": ["version", "type"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "type": {
      "enum": [
        "auth",
        "auth_response",
        "version_negotiate",
        "version_negotiate_ack",
        "flow_control",
        "open_tunnel",
        "open_tunnel_ack",
        "close_tunnel",
        "data",
        "heartbeat",
        "error",
        "http_request",
        "http_response",
        "tcp_data",
        "tcp_close",
        "udp_data",
        "udp_response"
      ]
    },
    "request_id": { "type": "string" },
    "payload": {}
  },
  "additionalProperties": false,
  "$defs": {
    "auth": {
      "type": "object",
      "required": ["token"],
      "properties": {
        "token": { "type": "string" },
        "agent_id": { "type": "string" },
        "requested_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "auth_response": {
      "type": "object",
      "required": ["authenticated"],
      "properties": {
        "authenticated": { "type": "boolean" },
        "agent_id": { "type": "string" },
        "organization_id": { "type": "string" },
        "granted_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "version_negotiate": {
      "type": "object",
      "required": ["min_version", "max_version"],
      "properties": {
        "min_version": { "type": "integer", "minimum": 1 },
        "max_version": { "type": "integer", "minimum": 1 },
        "client_name": { "type": "string" },
        "client_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "version_negotiate_ack": {
      "type": "object",
      "required": ["negotiated_version", "supported_versions"],
      "properties": {
        "negotiated_version": { "type": "integer" },
        "supported_versions": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "server_name": { "type": "string" },
        "server_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "flow_control": {
      "type": "object",
      "required": ["stream_id", "action"],
      "properties": {
        "stream_id": { "type": "string" },
        "action": { "type": "string", "enum": ["pause", "resume"] },
        "window_size": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "open_tunnel": {
      "type": "object",
      "required": ["token", "local_port", "protocol"],
      "properties": {
        "token": { "type": "string" },
        "tunnel_id": { "type": "string" },
        "local_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "subdomain": { "type": "string" },
        "protocol": { "type": "string", "enum": ["http", "https", "tcp", "udp"] },
        "custom_domain": { "type": "string" },
        "password": { "type": "string", "minLength": 8, "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "open_tunnel_ack": {
      "type": "object",
      "required": ["tunnel_id", "public_url"],
      "properties": {
        "tunnel_id": { "type": "string" },
        "public_url": { "type": "string", "format": "uri" },
        "public_port": { "type": "integer", "minimum": 0, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "close_tunnel": {
      "type": "object",
      "required": ["tunnel_id"],
      "properties": {
        "tunnel_id": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "required": ["tunnel_id", "stream_id", "data"],
      "properties": {
        "tunnel_id": { "type": "string" },
        "stream_id": { "type": "string" },
        "data": { "type": "string", "contentEncoding": "base64" }
      },
      "additionalProperties": false
    },
    "heartbeat": {
      "type": "object",
      "required": ["timestamp"],
      "properties": { "timestamp": { "type": "integer" } },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
